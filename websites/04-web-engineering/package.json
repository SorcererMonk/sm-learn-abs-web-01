{
  "name": "04-web-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web engineering: the browser as a runtime, the network, the server and the practice of shipping, with a real Node backend behind every lab.",
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node --no-warnings=ExperimentalWarning server/main.ts",
    "dev": "node server/dev.ts",
    "build": "astro build",
    "check": "astro check",
    "coverage": "node ../shared/tools/coverage.ts --site 04-web-engineering",
    "test": "cd .. && vitest run 04-web-engineering shared",
    "test:e2e": "playwright test",
    "budget": "node ../shared/tools/budget.ts --site 04-web-engineering",
    "lighthouse": "node --no-warnings=ExperimentalWarning ../shared/tools/lighthouse.ts --site 04-web-engineering",
    "verify": "npm run coverage -- --check && npm run check && npm test && npm run build && npm run budget && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/markdown-remark": "7.3.1",
    "@learn/shared": "1.0.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10"
  }
}
