{
  "$description": "Shared design tokens for all five learning sites (W3C Design Tokens Community Group format). Colour values reference var(--brand-hue) so each site re-brands by setting one number. Dark-mode values live in $extensions['learn.dark'] and compile to light-dark().",
  "brand": {
    "hue": { "$type": "number", "$value": 35, "$description": "Overridden per site." }
  },
  "color": {
    "canvas": {
      "$type": "color",
      "$value": "oklch(0.985 0.004 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.17 0.012 var(--brand-hue))" }
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(1 0 0)",
      "$extensions": { "learn.dark": "oklch(0.215 0.014 var(--brand-hue))" }
    },
    "surface-2": {
      "$type": "color",
      "$value": "oklch(0.955 0.008 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.255 0.016 var(--brand-hue))" }
    },
    "surface-inverse": {
      "$type": "color",
      "$value": "oklch(0.22 0.02 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.94 0.01 var(--brand-hue))" }
    },
    "text": {
      "$type": "color",
      "$value": "oklch(0.235 0.018 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.935 0.008 var(--brand-hue))" }
    },
    "text-muted": {
      "$type": "color",
      "$value": "oklch(0.47 0.02 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.76 0.014 var(--brand-hue))" }
    },
    "text-inverse": {
      "$type": "color",
      "$value": "oklch(0.97 0.006 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.2 0.018 var(--brand-hue))" }
    },
    "border": {
      "$type": "color",
      "$value": "oklch(0.89 0.01 var(--brand-hue))",
      "$description": "Decorative separators only.",
      "$extensions": { "learn.dark": "oklch(0.32 0.014 var(--brand-hue))" }
    },
    "border-strong": {
      "$type": "color",
      "$value": "oklch(0.6 0.02 var(--brand-hue))",
      "$description": "Boundaries of interactive controls: must reach 3:1 (WCAG 1.4.11).",
      "$extensions": { "learn.dark": "oklch(0.56 0.02 var(--brand-hue))" }
    },
    "accent": {
      "$type": "color",
      "$value": "oklch(0.52 0.17 var(--brand-hue))",
      "$description": "Accent used as text (links): must reach 4.5:1 on canvas and surfaces.",
      "$extensions": { "learn.dark": "oklch(0.8 0.13 var(--brand-hue))" }
    },
    "accent-strong": {
      "$type": "color",
      "$value": "oklch(0.5 0.18 var(--brand-hue))",
      "$description": "Filled button background.",
      "$extensions": { "learn.dark": "oklch(0.8 0.13 var(--brand-hue))" }
    },
    "on-accent": {
      "$type": "color",
      "$value": "oklch(0.99 0.004 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.18 0.02 var(--brand-hue))" }
    },
    "accent-subtle": {
      "$type": "color",
      "$value": "oklch(0.95 0.035 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.29 0.05 var(--brand-hue))" }
    },
    "focus": {
      "$type": "color",
      "$value": "oklch(0.5 0.2 var(--brand-hue))",
      "$extensions": { "learn.dark": "oklch(0.83 0.14 var(--brand-hue))" }
    },
    "success": {
      "$type": "color",
      "$value": "oklch(0.49 0.12 150)",
      "$extensions": { "learn.dark": "oklch(0.82 0.13 150)" }
    },
    "warning": {
      "$type": "color",
      "$value": "oklch(0.5 0.11 65)",
      "$extensions": { "learn.dark": "oklch(0.85 0.13 85)" }
    },
    "danger": {
      "$type": "color",
      "$value": "oklch(0.52 0.19 25)",
      "$extensions": { "learn.dark": "oklch(0.78 0.14 25)" }
    },
    "info": {
      "$type": "color",
      "$value": "oklch(0.5 0.13 245)",
      "$extensions": { "learn.dark": "oklch(0.8 0.1 245)" }
    },
    "shadow": {
      "$type": "color",
      "$value": "oklch(0.3 0.04 var(--brand-hue) / 0.1)",
      "$description": "Shadows are tinted by the brand hue, never pure black.",
      "$extensions": { "learn.dark": "oklch(0.05 0.01 var(--brand-hue) / 0.55)" }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": ["Fraunces Variable", "Fraunces Fallback", "Georgia", "serif"]
    },
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Instrument Sans Variable",
        "Instrument Sans Fallback",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["ui-monospace", "SF Mono", "Cascadia Code", "Roboto Mono", "Menlo", "Consolas", "monospace"]
    },
    "indic": {
      "$type": "fontFamily",
      "$value": ["Noto Sans Devanagari", "Noto Sans Tamil", "Mukta", "Nirmala UI", "sans-serif"]
    }
  },
  "fluid": {
    "$description": "Utopia-style scale: 16px/1.2 at 360px viewport to 19px/1.25 at 1440px.",
    "$extensions": {
      "learn.fluid": {
        "minViewport": 360,
        "maxViewport": 1440,
        "minBase": 16,
        "maxBase": 19,
        "minRatio": 1.2,
        "maxRatio": 1.25,
        "typeSteps": [-2, -1, 0, 1, 2, 3, 4, 5, 6, 7],
        "space": {
          "3xs": 0.25,
          "2xs": 0.5,
          "xs": 0.75,
          "s": 1,
          "m": 1.5,
          "l": 2,
          "xl": 3,
          "2xl": 4,
          "3xl": 6
        }
      }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.375rem" },
    "md": { "$type": "dimension", "$value": "0.75rem" },
    "lg": { "$type": "dimension", "$value": "1.25rem" },
    "xl": { "$type": "dimension", "$value": "2rem" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "measure": { "$type": "dimension", "$value": "66ch" },
    "content": { "$type": "dimension", "$value": "72rem" },
    "wide": { "$type": "dimension", "$value": "90rem" },
    "target": { "$type": "dimension", "$value": "2.75rem", "$description": "44px comfortable touch target." }
  },
  "shadow": {
    "1": {
      "$type": "shadow",
      "$value": [
        { "offsetX": "0", "offsetY": "1px", "blur": "1px", "spread": "0", "color": "{color.shadow}" },
        { "offsetX": "0", "offsetY": "2px", "blur": "6px", "spread": "-1px", "color": "{color.shadow}" }
      ]
    },
    "2": {
      "$type": "shadow",
      "$value": [
        { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "{color.shadow}" },
        { "offsetX": "0", "offsetY": "4px", "blur": "10px", "spread": "-2px", "color": "{color.shadow}" },
        { "offsetX": "0", "offsetY": "12px", "blur": "24px", "spread": "-6px", "color": "{color.shadow}" }
      ]
    },
    "3": {
      "$type": "shadow",
      "$value": [
        { "offsetX": "0", "offsetY": "2px", "blur": "4px", "spread": "0", "color": "{color.shadow}" },
        { "offsetX": "0", "offsetY": "10px", "blur": "20px", "spread": "-4px", "color": "{color.shadow}" },
        { "offsetX": "0", "offsetY": "28px", "blur": "48px", "spread": "-12px", "color": "{color.shadow}" }
      ]
    }
  },
  "duration": {
    "fast": { "$type": "duration", "$value": "150ms", "$description": "Micro-feedback: press, toggle, hover." },
    "base": { "$type": "duration", "$value": "250ms", "$description": "Component transitions: menus, fades, tooltips." },
    "slow": { "$type": "duration", "$value": "400ms", "$description": "Larger panels, sheets, page transitions." }
  },
  "ease": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1],
      "$description": "Material 3 standard: on-screen movement."
    },
    "out": {
      "$type": "cubicBezier",
      "$value": [0.05, 0.7, 0.1, 1],
      "$description": "Emphasized decelerate: things entering or responding to input."
    },
    "in": {
      "$type": "cubicBezier",
      "$value": [0.3, 0, 0.8, 0.15],
      "$description": "Emphasized accelerate: things leaving."
    },
    "spring": {
      "$type": "spring",
      "$value": { "duration": 0.45, "bounce": 0.22 },
      "$description": "Friendly spring compiled to linear(); used for toggles and presses."
    }
  },
  "z": {
    "raised": { "$type": "number", "$value": 10 },
    "sticky": { "$type": "number", "$value": 100 },
    "overlay": { "$type": "number", "$value": 1000 }
  }
}
