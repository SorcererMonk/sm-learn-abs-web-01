---
/**
 * Self-hosted variable fonts (no third-party requests), preloaded, with metric-matched
 * fallbacks so the swap causes no layout shift. Fallback metrics were measured with fontTools
 * against Liberation Serif/Sans (metric-compatible with Times New Roman/Arial):
 *   Fraunces: avg glyph width 0.543em vs 0.444em -> size-adjust 122.1%, ascent 0.978/1.221, descent 0.255/1.221
 *   Instrument Sans: 0.484em vs 0.475em -> size-adjust 102%, ascent 0.970/1.02, descent 0.25/1.02
 */
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import instrument from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

const css = `
@font-face{font-family:"Fraunces Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${fraunces}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Instrument Sans Variable";font-style:normal;font-display:swap;font-weight:400 700;src:url(${instrument}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Fraunces Fallback";src:local("Times New Roman"),local("Liberation Serif"),local("Times");size-adjust:122.1%;ascent-override:80.1%;descent-override:20.9%;line-gap-override:0%}
@font-face{font-family:"Instrument Sans Fallback";src:local("Arial"),local("Liberation Sans"),local("Helvetica");size-adjust:102%;ascent-override:95.1%;descent-override:24.5%;line-gap-override:0%}
`;
---

<link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={instrument} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css} />
