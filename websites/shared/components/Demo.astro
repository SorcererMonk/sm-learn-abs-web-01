---
/** Frame for an interactive demo. Named slots: default body, "controls", "note". */
interface Props {
  title: string;
  badge?: string;
  id?: string;
}
const { title, badge = 'Live demo', id } = Astro.props;
---

<section class="demo" id={id} aria-label={title}>
  <div class="demo__header">
    <span class="demo__badge">{badge}</span>
    <h3 class="demo__title">{title}</h3>
  </div>
  <div class="demo__body">
    {Astro.slots.has('controls') && (
      <div class="controls">
        <slot name="controls" />
      </div>
    )}
    <slot />
  </div>
  {Astro.slots.has('note') && (
    <div class="demo__note">
      <slot name="note" />
    </div>
  )}
</section>
