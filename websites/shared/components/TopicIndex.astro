---
/**
 * The filterable index of every Part (search + tier/source chips). Rendered complete on the
 * server; client/topic-index.ts only hides rows, so without JS everything is listed.
 */
export interface IndexItem {
  id: string;
  href: string;
  part: number;
  title: string;
  summary: string;
  tier: string;
  group: string;
  groupLabel: string;
  keywords: string;
}

interface Props {
  items: IndexItem[];
  label?: string;
}
const { items, label = 'Every part' } = Astro.props;
const tierKeys = (tier: string): string =>
  ['Core', 'Deep', 'Frontier', 'Lifelong'].filter((t) => tier.includes(t)).map((t) => t.toLowerCase()).join(' ');
const groups = [...new Map(items.map((i) => [i.group, i.groupLabel])).entries()];
---

<section class="stack" data-topic-index aria-labelledby="index-title">
  <h2 id="index-title">{label}</h2>
  <div class="index-controls" hidden>
    <label class="control" for="index-search">
      <span>Search parts and topics</span>
      <input id="index-search" type="search" placeholder="e.g. cascade, grid, dialog" autocomplete="off" />
    </label>
    <div class="cluster" role="group" aria-label="Filter by tier">
      {['Core', 'Deep', 'Frontier', 'Lifelong'].map((t) => (
        <button type="button" class="chip" aria-pressed="false" data-filter={`tier:${t.toLowerCase()}`}>{t}</button>
      ))}
    </div>
    {
      groups.length > 1 && (
        <div class="cluster" role="group" aria-label="Filter by source">
          {groups.map(([key, text]) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={`group:${key}`}>{text}</button>
          ))}
        </div>
      )
    }
    <p class="muted" data-index-status aria-live="polite"></p>
  </div>
  <ol class="index-list" role="list">
    {
      items.map((item) => (
        <li
          class="index-row"
          data-lesson-row={item.id}
          data-tier={tierKeys(item.tier)}
          data-group={item.group}
          data-search={`${item.title} ${item.summary} ${item.keywords}`.toLowerCase()}
        >
          <span class="index-row__num" aria-hidden="true">{String(item.part).padStart(2, '0')}</span>
          <h3 class="index-row__title">
            <a href={item.href}>
              <span class="visually-hidden">Part {item.part}: </span>
              {item.title}
            </a>
          </h3>
          <span class="tier" data-tier={item.tier}>{item.tier}</span>
          <p class="index-row__meta">
            <span>{item.groupLabel}</span>
            <span aria-hidden="true">·</span>
            <span>{item.summary}</span>
          </p>
        </li>
      ))
    }
  </ol>
</section>
