---
/**
 * Layout for one PART of a learning file. The MDX body supplies one section per source topic;
 * this layout adds the Part's intuition anchors, mastery checks (with model answers),
 * the build/analysis exercise, the taste note, a quiz, completion tracking and prev/next.
 */
import BaseLayout from './BaseLayout.astro';
import { renderInline } from '../lib/inline-md.ts';
import { renderQuiz } from '../lib/render-quiz.ts';
import { hashId } from '../lib/md-source.ts';
import type { LessonData } from '../lib/lesson-schema.ts';
import type { LessonLink, SiteConfig } from '../lib/site.ts';

interface Props {
  site: SiteConfig;
  lesson: LessonData;
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
  prev?: LessonLink;
  next?: LessonLink;
  totalParts: number;
  sourceLabel: string;
  exerciseLabel?: string;
  /** Training page for this source, when the curriculum has one. */
  dojoHref?: string;
}

const {
  site,
  lesson,
  slug,
  headings,
  prev,
  next,
  totalParts,
  sourceLabel,
  exerciseLabel = 'Build',
  dojoHref,
} = Astro.props;
const topics = headings.filter((h) => h.depth === 2);
const lessonId = `${lesson.source}:${lesson.part}`;
const html = (text: string): string => renderInline(text);
const fixed = [
  { slug: 'anchors', text: 'Intuition anchors' },
  { slug: 'checks', text: 'Mastery checks' },
  ...(lesson.quiz.length ? [{ slug: 'quiz', text: 'Quick quiz' }] : []),
  { slug: 'exercise', text: exerciseLabel },
  { slug: 'taste', text: 'Taste' },
];
---

<BaseLayout
  site={site}
  title={`Part ${lesson.part}: ${lesson.title}`}
  description={lesson.summary}
  showProgress
  totalParts={totalParts}
>
  <div class="page-grid" style="--page-row-gap: 0">
    <header class="lesson-hero stack">
      <p class="kicker">
        {sourceLabel}
        {lesson.track ? ` · ${lesson.track}` : ''} · Part {lesson.part}
      </p>
      <span class="lesson-hero__num" aria-hidden="true">
        {String(lesson.part).padStart(2, '0')}
      </span>
      <h1 style={`view-transition-name: lesson-${slug}`}>{lesson.title}</h1>
      <p class="lede">{lesson.summary}</p>
      <p class="cluster">
        <span class="tier" data-tier={lesson.tier}>
          {lesson.tier}
        </span>
        <span class="muted">
          {topics.length} topics · source: <code>{lesson.source}</code> PART {lesson.part}
        </span>
      </p>
    </header>

    <div class="lesson-layout">
      <aside>
        <nav class="toc stack stack-sm" aria-label="In this part" data-toc>
          <h2 class="kicker">In this part</h2>
          <ol>
            {topics.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
            {fixed.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="lesson-body">
        <slot />

        <section id="anchors" class="lesson-extra stack" aria-labelledby="anchors-title">
          <h2 id="anchors-title" class="lesson-section-title">
            Intuition anchors
          </h2>
          {lesson.anchors.map((a) => (
            <div class="callout" data-kind="anchor">
              <p class="callout__label">Anchor</p>
              <p set:html={html(a)} />
            </div>
          ))}
        </section>

        <section id="checks" class="lesson-extra stack" aria-labelledby="checks-title">
          <h2 id="checks-title" class="lesson-section-title">
            Mastery checks
          </h2>
          <p class="muted">Answer out loud or on paper first, then open the model answer.</p>
          <div class="checks">
            {lesson.checks.map((c) => (
              <details>
                <summary set:html={html(c.q)} />
                <div>
                  {c.a.split('\n\n').map((para) => (
                    <p set:html={html(para)} />
                  ))}
                </div>
              </details>
            ))}
          </div>
        </section>

        {lesson.quiz.length > 0 && (
          <div
            id="quiz"
            class="lesson-extra"
            set:html={renderQuiz(`quiz-${slug}`, lesson.quiz, 'Quick quiz')}
          />
        )}

        <section id="exercise" class="lesson-extra stack" aria-labelledby="exercise-title">
          <h2 id="exercise-title" class="lesson-section-title">
            {exerciseLabel}
          </h2>
          <div class="callout" data-kind="try">
            <p class="callout__label">Project</p>
            <p set:html={html(lesson.build)} />
          </div>
          {lesson.steps.length > 0 && (
            <ul class="checklist" role="list">
              {lesson.steps.map((step) => (
                <li>
                  <label class="check">
                    <input type="checkbox" data-progress-id={`${lessonId}:step:${hashId(step)}`} />
                    <span set:html={html(step)} />
                  </label>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section id="taste" class="lesson-extra stack" aria-labelledby="taste-title">
          <h2 id="taste-title" class="lesson-section-title">
            Taste
          </h2>
          <div class="callout" data-kind="taste">
            <p class="callout__label">Taste</p>
            <p set:html={html(lesson.taste)} />
          </div>
        </section>

        <div class="lesson-extra cluster">
          <button type="button" class="btn" data-lesson-done data-lesson-id={lessonId} hidden>
            Mark this part as complete
          </button>
          {dojoHref && (
            <a class="btn btn--ghost" href={dojoHref}>
              Practise in the dojo
            </a>
          )}
        </div>

        <nav class="pager lesson-extra" aria-label="Previous and next part">
          {prev && (
            <a href={prev.href} rel="prev">
              <small>← Part {prev.part}</small>
              {prev.title}
            </a>
          )}
          {next && (
            <a href={next.href} rel="next">
              <small>Part {next.part} →</small>
              {next.title}
            </a>
          )}
        </nav>
      </article>
    </div>
  </div>
</BaseLayout>
