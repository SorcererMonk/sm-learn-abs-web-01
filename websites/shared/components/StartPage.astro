---
/**
 * Orientation: how the site maps onto the curriculum, then each learning file's
 * "How To Use This Document" (depth ladder, tier tags, learning loop) and its currency stamp.
 */
import { readFileSync } from 'node:fs';
import BaseLayout from './BaseLayout.astro';
import SourceSection from './SourceSection.astro';
import { repoPath } from '../lib/content.ts';
import { parseCurriculum } from '../lib/md-source.ts';
import { renderInline } from '../lib/inline-md.ts';
import type { SiteConfig } from '../lib/site.ts';

interface Props {
  site: SiteConfig;
}
const { site } = Astro.props;
const learning = site.sources
  .map((s) => ({ source: s, curriculum: parseCurriculum(readFileSync(repoPath(s.file), 'utf8'), s.file) }))
  .filter((x) => x.curriculum.kind === 'learning');
---

<BaseLayout site={site} title="Start here">
  <div class="page-grid" style="--page-row-gap: var(--space-l)">
    <header class="lesson-hero stack">
      <p class="kicker">Orientation</p>
      <h1>Start here</h1>
      <p class="lede">How this site is organised, how deep to go, and what is current as of September 2026.</p>
    </header>

    <section class="stack prose" aria-labelledby="map-title">
      <h2 id="map-title">How the site maps onto the curriculum</h2>
      <slot />
    </section>

    {
      learning.map(({ source, curriculum }) => (
        <section class="stack" aria-labelledby={`${source.file}-use`}>
          <h2 id={`${source.file}-use`}>
            {curriculum.title.replace(/\s*→.*/, '')} <span class="muted">· how to use it</span>
          </h2>
          <div class="callout" data-kind="note">
            <p class="callout__label">What's current (from the source's currency stamp)</p>
            {curriculum.intro
              .split('\n')
              .filter(Boolean)
              .map((line) => (
                <p set:html={renderInline(line)} />
              ))}
          </div>
          <SourceSection path={repoPath(source.file)} file={source.file} section="How To Use This Document" />
        </section>
      ))
    }
  </div>
</BaseLayout>
