---
/**
 * The real document outline is the heading levels. Paste markup and see the outline a
 * screen-reader user navigates by, with skipped levels and extra h1s flagged.
 */
import Demo from '@learn/shared/components/Demo.astro';

const initial = `<header><h1>The Daily Planet</h1></header>
<main>
  <article>
    <h2>City council approves new cycle lanes</h2>
    <h4>Reactions</h4>
    <section>
      <h3>What changes on Monday</h3>
    </section>
  </article>
  <aside><h2>Related stories</h2></aside>
</main>
<footer><h1>Contact us</h1></footer>`;
---

<Demo title="Heading outline and landmark checker">
  <div class="stack" data-outline>
    <label class="control" for="outline-input">
      <span>Page markup</span>
      <textarea id="outline-input" rows="10" spellcheck="false">{initial}</textarea>
    </label>
    <div class="switcher" style="--switcher-threshold: 34rem">
      <div class="stack stack-sm">
        <h5 class="kicker">Heading outline</h5>
        <ol class="outline" role="list" data-outline-list></ol>
      </div>
      <div class="stack stack-sm">
        <h5 class="kicker">Problems</h5>
        <ul class="stack stack-sm" role="list" data-outline-problems aria-live="polite"></ul>
      </div>
    </div>
  </div>
  <p slot="note">
    Screen-reader users jump by heading level (VoiceOver rotor, NVDA's H key). Levels are the
    structure: the old "outline algorithm" based on sectioning elements was never implemented.
  </p>
</Demo>

<script>
  document.querySelectorAll<HTMLElement>('[data-outline]').forEach((root) => {
    const input = root.querySelector('textarea');
    const list = root.querySelector('[data-outline-list]');
    const problems = root.querySelector('[data-outline-problems]');
    if (!input || !list || !problems) return;
    const run = (): void => {
      const doc = new DOMParser().parseFromString(input.value, 'text/html');
      const headings = [...doc.querySelectorAll('h1, h2, h3, h4, h5, h6')];
      const issues: string[] = [];
      let previous = 0;
      list.replaceChildren(
        ...headings.map((h) => {
          const level = Number(h.localName[1]);
          const li = document.createElement('li');
          li.style.paddingInlineStart = `${(level - 1) * 1.25}rem`;
          li.textContent = `H${level} · ${h.textContent?.trim() ?? ''}`;
          if (previous && level > previous + 1) {
            li.dataset.bad = '';
            issues.push(`Skipped level: H${previous} → H${level} ("${h.textContent?.trim()}")`);
          }
          previous = level;
          return li;
        }),
      );
      const h1s = headings.filter((h) => h.localName === 'h1').length;
      if (h1s !== 1) issues.push(`${h1s} <h1> elements: aim for exactly one per page.`);
      if (!doc.querySelector('main')) issues.push('No <main> landmark.');
      if (doc.querySelectorAll('main').length > 1) issues.push('More than one <main>.');
      problems.replaceChildren(
        ...(issues.length ? issues : ['No problems found.']).map((text) => {
          const li = document.createElement('li');
          li.textContent = text;
          return li;
        }),
      );
    };
    input.addEventListener('input', run);
    run();
  });
</script>

<style>
  .outline {
    display: grid;
    gap: 0.2rem;
    font-size: var(--step-n1);
    font-family: var(--font-mono);
  }
  .outline :global(li[data-bad]) {
    color: var(--color-danger);
    font-weight: 700;
  }
</style>
