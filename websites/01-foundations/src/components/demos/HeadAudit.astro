---
/**
 * Paste a <head>, get the Part 6 checks (lib/head-audit.ts) plus a search-result and
 * share-card preview built from the same metadata.
 */
import Demo from '@learn/shared/components/Demo.astro';

const initial = `<html>
<head>
  <title>Home</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <meta name="description" content="Welcome to our website">
  <meta name="generator" content="SiteBuilder 3.2">
  <meta property="og:title" content="Cycle lanes approved">
  <meta property="og:image" content="https://planet.example/og/cycle-lanes.png">
  <link rel="preload" href="/fonts/serif.woff2" as="font">
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle"}</script>
</head>
</html>`;
---

<Demo title="Head audit and share preview">
  <div class="stack" data-head-audit>
    <label class="control" for="head-input">
      <span>Your document head (edit and fix it until every row is OK)</span>
      <textarea id="head-input" rows="14" spellcheck="false">{initial}</textarea>
    </label>
    <div class="switcher" style="--switcher-threshold: 40rem">
      <div class="stack stack-sm">
        <h4 class="kicker">Findings</h4>
        <ul class="audit" role="list" aria-live="polite" data-audit-list></ul>
      </div>
      <div class="stack stack-sm">
        <h4 class="kicker">In search results</h4>
        <div class="serp" data-serp>
          <span class="serp__url" data-serp-url></span>
          <span class="serp__title" data-serp-title></span>
          <span class="serp__desc" data-serp-desc></span>
        </div>
        <h4 class="kicker">As a share card</h4>
        <div class="share" data-share>
          <div class="share__image" data-share-image></div>
          <div class="share__text">
            <span class="share__site" data-share-site></span>
            <strong data-share-title></strong>
            <span data-share-desc></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <p slot="note">
    Previews are approximations: every platform truncates differently, which is why titles should
    front-load the distinctive words.
  </p>
</Demo>

<script>
  import { need } from '@learn/shared/client/controls.ts';
  import { auditHead } from '../../lib/head-audit.ts';

  const labels = { error: 'Error', warn: 'Warning', ok: 'OK' } as const;

  document.querySelectorAll<HTMLElement>('[data-head-audit]').forEach((root) => {
    const input = need<HTMLTextAreaElement>(root, 'textarea');
    const list = need<HTMLUListElement>(root, '[data-audit-list]');
    const set = (selector: string, text: string): void => {
      need<HTMLElement>(root, selector).textContent = text;
    };
    const run = (): void => {
      const doc = new DOMParser().parseFromString(input.value, 'text/html');
      const findings = auditHead(doc).sort(
        (a, b) =>
          ['error', 'warn', 'ok'].indexOf(a.level) - ['error', 'warn', 'ok'].indexOf(b.level),
      );
      list.replaceChildren(
        ...findings.map((f) => {
          const li = document.createElement('li');
          li.dataset.level = f.level;
          const tag = document.createElement('strong');
          tag.textContent = `${labels[f.level]}: `;
          li.append(tag, f.message);
          return li;
        }),
      );
      const pick = (name: string): string =>
        doc.head
          .querySelector(`meta[name="${name}"], meta[property="${name}"]`)
          ?.getAttribute('content') ?? '';
      const url =
        doc.head.querySelector('link[rel="canonical"]')?.getAttribute('href') ||
        pick('og:url') ||
        'https://example.com/';
      const clip = (text: string, n: number): string =>
        text.length > n ? `${text.slice(0, n - 1)}…` : text;
      set('[data-serp-url]', url);
      set('[data-serp-title]', clip(doc.title || '(no title)', 60));
      set(
        '[data-serp-desc]',
        clip(
          pick('description') || '(no description: the engine will pick text from the page)',
          160,
        ),
      );
      set('[data-share-site]', new URL(url, 'https://example.com').hostname);
      set('[data-share-title]', clip(pick('og:title') || doc.title || '(no title)', 70));
      set('[data-share-desc]', clip(pick('og:description') || pick('description'), 110));
      need<HTMLElement>(root, '[data-share-image]').dataset.missing = String(!pick('og:image'));
    };
    input.addEventListener('input', run);
    run();
  });
</script>

<style>
  .audit {
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--step-n1);
  }
  .audit :global(li) {
    padding: 0.3rem 0.6rem;
    border-inline-start: 4px solid var(--color-success);
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
  }
  .audit :global(li[data-level='warn']) {
    border-color: var(--color-warning);
  }
  .audit :global(li[data-level='error']) {
    border-color: var(--color-danger);
  }
  .serp {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
  }
  .serp__url {
    font-size: var(--step-n2);
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
  .serp__title {
    color: var(--color-info);
    font-size: var(--step-1);
  }
  .serp__desc,
  .share__text span {
    font-size: var(--step-n1);
    color: var(--color-text-muted);
  }
  .share {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .share__image {
    aspect-ratio: 1200 / 630;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-strong));
  }
  .share__image[data-missing='true'] {
    background: repeating-linear-gradient(
      45deg,
      var(--color-surface-2) 0 10px,
      var(--color-surface) 10px 20px
    );
  }
  .share__text {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-xs);
  }
  .share__site {
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
