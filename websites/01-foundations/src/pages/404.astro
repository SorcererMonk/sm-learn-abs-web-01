---
import BaseLayout from '@learn/shared/components/BaseLayout.astro';
import { withBase } from '@learn/shared/lib/content.ts';
import { site } from '../site';
---

<BaseLayout site={site} title="Page not found">
  <div class="page-grid">
    <section class="hero stack">
      <p class="kicker">404</p>
      <h1 class="hero__title">This page <em>doesn't</em> exist.</h1>
      <p class="lede">The link may be old, or the part may have moved. Every part is listed in the index.</p>
      <p class="cluster">
        <a class="btn" href={withBase('/learn/')}>All parts</a>
        <a class="btn btn--ghost" href={withBase('/')}>Home</a>
      </p>
    </section>
  </div>
</BaseLayout>
